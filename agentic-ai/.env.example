# Copy to agentic-ai/.env.  Every setting in config.py can be set here.

# Groq LLM (optional: without it the Diagnosis agent runs rule-based)
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# ns-3 output to analyse (relative paths are relative to agentic-ai/)
NS3_METRICS_DIR=../ns-3.48/MetricsOutput

# dry_run = record actions only; ns3_rerun = execute supported actions in ns-3
EXECUTOR_BACKEND=dry_run
NS3_DIR=../ns-3.48

# RAG embedder: sentence-transformers (default) or hashing (offline fallback)
RAG_EMBEDDER=sentence-transformers
